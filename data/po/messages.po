msgstr ""

#: tmp.desktop.in:8 ../org.equeim.Rtremotesf.appdata.xml.in:15
msgid "Remote GUI for rtorrent BitTorrent client"
msgstr ""

#: ../org.equeim.Rtremotesf.appdata.xml.in:18
msgid ""
"Rtremotesf is a remote GUI for rtorrent BitTorrent client. You can fully "
"control your rtorrent instance, manage torrents, configure its settings, "
"view server statistics. Rtremotesf talks to rtorrent's XML-RPC interface "
"over SCGI."
msgstr ""

#: ../org.equeim.Rtremotesf.appdata.xml.in:23
msgid ""
"You can add several server profiles and switch between them (only one can be "
"connected at a time). You can set mounted directories for servers and "
"quickly open torrents' files and choose download directory from a file "
"dialog."
msgstr ""
