[Desktop Entry]
Type=Application
Name=rtremotesf
Comment=Remote GUI for rtorrent BitTorrent client
Categories=Network;P2P;
Icon=rtremotesf
Exec=rtremotesf %U
StartupNotify=true
StartupWMClass=rtremotesf
X-GNOME-SingleWindow=true
SingleMainWindow=true
MimeType=application/x-bittorrent;x-scheme-handler/magnet;
