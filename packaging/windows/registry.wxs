<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Fragment>
            <Component Id="TorrentFileTypeRegistration" Guid="7bbef274-8035-4a34-a18d-61cd1d2cafd2" NeverOverwrite="yes" Permanent="yes" Directory="INSTALL_ROOT">
                <RegistryKey Root="HKCU" Key="Software\Classes\.torrent">
                    <RegistryValue Type="string" Name="Content Type" Value="application/x-bittorrent" KeyPath="yes" />
                </RegistryKey>
            </Component>

            <Component Id="MagnetProtocolRegistration" Guid="028d2337-2b21-48c4-8a44-17db12ccdbfd" NeverOverwrite="yes" Permanent="yes" Directory="INSTALL_ROOT">
                <RegistryKey Root="HKCU" Key="Software\Classes\magnet">
                    <RegistryValue Type="string" Value="URL:Magnet link" KeyPath="yes" />
                    <RegistryValue Type="string" Name="URL Protocol" Value="" />
                </RegistryKey>
            </Component>

            <Component Id="FileAssociationRegistration" Guid="ee9cb37f-c113-45f7-b23b-fa7dbb72d648" Directory="INSTALL_ROOT">
                <RegistryKey Root="HKCU" Key="Software\Classes\rtremotesf.TorrentFile.1">
                    <RegistryValue Type="string" Value="Torrent file" />
                    <RegistryValue Type="string" Name="FriendlyTypeName" Value="@&quot;[#CM_FP_rtremotesf.exe]&quot;,0" />
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="&quot;[#CM_FP_rtremotesf.exe]&quot;,0" />
                    </RegistryKey>
                    <RegistryKey Key="Shell">
                        <RegistryKey Key="Open">
                            <RegistryKey Key="command">
                                <RegistryValue Type="string" Value="&quot;[#CM_FP_rtremotesf.exe]&quot; &quot;%1&quot;" />
                            </RegistryKey>
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>

                <RegistryKey Root="HKCU" Key="Software\Classes\.torrent\OpenWithProgids">
                    <RegistryValue Type="string" Name="rtremotesf.TorrentFile.1" Value="" />
                </RegistryKey>

                <RegistryKey Root="HKCU" Key="Software\Classes\rtremotesf.MagnetLink.1">
                    <RegistryValue Type="string" Value="Magnet link" />
                    <RegistryValue Type="string" Name="FriendlyTypeName" Value="@&quot;[#CM_FP_rtremotesf.exe]&quot;,1" />
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="&quot;[#CM_FP_rtremotesf.exe]&quot;,0" />
                    </RegistryKey>
                    <RegistryKey Key="Shell">
                        <RegistryKey Key="Open">
                            <RegistryKey Key="command">
                                <RegistryValue Type="string" Value="&quot;[#CM_FP_rtremotesf.exe]&quot; &quot;%1&quot;" />
                            </RegistryKey>
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>

                <RegistryKey Root="HKCU" Key="Software\rtremotesf\rtremotesf\Capabilities">
                    <RegistryValue Type="string" Name="ApplicationName" Value="rtremotesf" />
                    <RegistryValue Type="string" Name="ApplicationDescription" Value="rtremotesf - Remote GUI for rtorrent" />
                    <RegistryKey Key="FileAssociations">
                        <RegistryValue Type="string" Name=".torrent" Value="rtremotesf.TorrentFile.1" />
                    </RegistryKey>
                    <RegistryKey Key="MimeAssociations">
                        <RegistryValue Type="string" Name="application/x-bittorrent" Value="rtremotesf.TorrentFile.1" />
                    </RegistryKey>
                    <RegistryKey Key="UrlAssociations">
                        <RegistryValue Type="string" Name="magnet" Value="rtremotesf.MagnetLink.1" />
                    </RegistryKey>
                </RegistryKey>

                <RegistryKey Root="HKCU" Key="Software\RegisteredApplications">
                    <RegistryValue Type="string" Name="rtremotesf" Value="Software\rtremotesf\rtremotesf\Capabilities" />
                </RegistryKey>
            </Component>
        </Fragment>
</Wix>
